{
  "name": "vscode-widget-dashboard",
  "displayName": "Widget Dashboard",
  "description": "iOS-style widgets in your VS Code sidebar: clock, live stocks & crypto, sports scores, GitHub activity, notes, and ambient sounds",
  "version": "1.2.0",
  "publisher": "soohumkaushik",
  "author": {
    "name": "Soohum Kaushik",
    "url": "https://github.com/SoohumKaushik"
  },
  "license": "MIT",
  "icon": "resources/icon-marketplace.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SoohumKaushik/vscode-widget-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/SoohumKaushik/vscode-widget-dashboard/issues"
  },
  "homepage": "https://github.com/SoohumKaushik/vscode-widget-dashboard#readme",
  "keywords": [
    "dashboard",
    "widgets",
    "productivity",
    "clock",
    "notes",
    "github",
    "stocks",
    "crypto",
    "sports",
    "ambient"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "widgetDashboard.openDashboard",
        "title": "Open Widget Dashboard",
        "category": "Widget Dashboard"
      },
      {
        "command": "widgetDashboard.addWidget",
        "title": "Add Widget",
        "category": "Widget Dashboard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "widget-dashboard",
          "title": "Widget Dashboard",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "widget-dashboard": [
        {
          "type": "webview",
          "id": "widgetDashboard.mainView",
          "name": "Dashboard"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node build.js",
    "watch": "node build.js --watch",
    "compile": "tsc -p ./",
    "icon": "node scripts/generate-icon.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
